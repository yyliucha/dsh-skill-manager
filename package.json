{
  "name": "@jacksun1994/dsh-skill-switcher",
  "version": "0.9.0",
  "description": "Switch each DeepSeek Harness agent skill on, to user-only, or off — from the composer tool row and a Settings page.",
  "type": "module",
  "license": "MIT",
  "author": "yyliucha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyliucha/dsh-skill-switcher.git"
  },
  "homepage": "https://github.com/yyliucha/dsh-skill-switcher#readme",
  "bugs": {
    "url": "https://github.com/yyliucha/dsh-skill-switcher/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-switcher"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "assets/icon-512.png",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.2"
  },
  "scripts": {
    "test": "node --test test/skills.test.mjs test/activity.test.mjs test/rows.test.mjs test/scan.test.mjs test/drafts.test.mjs test/fileops.test.mjs test/usage.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
